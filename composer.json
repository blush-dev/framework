{
	"name": "blush-dev/framework",
	"description": "Blush Framework: the core of Blush, a flat-file CMS.",
	"type": "library",
	"keywords": ["cms", "flat-file"],
	"homepage": "https://github.com/blush-dev/framework",
	"license": "MIT",
	"authors": [
		{
			"name": "Justin Tadlock",
			"email": "justintadlock@gmail.com",
			"homepage": "https://justintadlock.com",
			"role": "Developer"
		}
	],
	"support": {
		"issues": "https://github.com/blush-dev/framework/issues"
	},
	"require": {
		"php": ">=8.5"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/php-compatibility": "^10.0@alpha",
		"phpstan/phpstan": "^2.2",
		"phpunit/phpunit": "^12.5",
		"squizlabs/php_codesniffer": "^4.0.4"
	},
	"autoload": {
		"psr-4": {
			"Blush\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Blush\\Tests\\": "tests/"
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=1G",
		"test": "phpunit",
		"check": [
			"@lint",
			"@analyse",
			"@test"
		]
	}
}
