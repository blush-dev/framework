{
	"color": {
		"$type": "color",
		"background": {
			"$value": "#fdfcfb",
			"$extensions": { "blush": { "modes": { "dark": "#141312" } } }
		},
		"surface": {
			"$value": "#f3f1ee",
			"$extensions": { "blush": { "modes": { "dark": "#1f1d1b" } } }
		},
		"text": {
			"$value": "#1d1b19",
			"$extensions": { "blush": { "modes": { "dark": "#ece9e5" } } }
		},
		"muted": {
			"$value": "#5c5752",
			"$extensions": { "blush": { "modes": { "dark": "#aaa39c" } } }
		},
		"accent": {
			"$value": "#a3285b",
			"$extensions": { "blush": { "modes": { "dark": "#f08bb4" } } }
		},
		"accent-hover": {
			"$value": "#7c1d45",
			"$extensions": { "blush": { "modes": { "dark": "#f7b3cf" } } }
		},
		"border": {
			"$value": "#dcd8d3",
			"$extensions": { "blush": { "modes": { "dark": "#3a3633" } } }
		},
		"focus": {
			"$value": "#1f5fbf",
			"$extensions": { "blush": { "modes": { "dark": "#8ab4f8" } } }
		},
		"info": {
			"$value": "#1f5fbf",
			"$extensions": { "blush": { "modes": { "dark": "#8ab4f8" } } }
		},
		"success": {
			"$value": "#2f6f3e",
			"$extensions": { "blush": { "modes": { "dark": "#8fd19e" } } }
		},
		"warning": {
			"$value": "#8a5a00",
			"$extensions": { "blush": { "modes": { "dark": "#f2c46d" } } }
		},
		"danger": {
			"$value": "#b3261e",
			"$extensions": { "blush": { "modes": { "dark": "#f2a19b" } } }
		}
	},
	"font": {
		"body": {
			"$type": "fontFamily",
			"$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "sans-serif"]
		},
		"mono": {
			"$type": "fontFamily",
			"$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"]
		},
		"size": { "$value": "clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem)" }
	},
	"line-height": { "$type": "number", "$value": 1.65 },
	"space": {
		"$type": "dimension",
		"xs": { "$value": { "value": 0.25, "unit": "rem" } },
		"s": { "$value": { "value": 0.5, "unit": "rem" } },
		"m": { "$value": { "value": 1, "unit": "rem" } },
		"l": { "$value": { "value": 2, "unit": "rem" } },
		"xl": { "$value": { "value": 4, "unit": "rem" } }
	},
	"measure": { "$type": "dimension", "$value": { "value": 42, "unit": "rem" } },
	"radius": { "$type": "dimension", "$value": { "value": 0.375, "unit": "rem" } }
}
