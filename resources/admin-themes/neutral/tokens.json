{
	"$schema": "../../schemas/admin-tokens.v1.schema.json",
	"schemaVersion": 1,
	"color": {
		"background": "light-dark(#f5f6f9, #0b0d12)",
		"surface": {
			"default": "light-dark(#ffffff, #13161d)",
			"subtle": "light-dark(#f0f2f6, #1a1e27)",
			"strong": "light-dark(#e7eaf0, #222733)"
		},
		"text": {
			"default": "light-dark(#11141b, #e9ebf0)",
			"secondary": "light-dark(#535b6b, #a3abba)",
			"muted": "light-dark(#858d9d, #747d8e)"
		},
		"accent": {
			"default": "light-dark(#2f5fe0, #7295f7)",
			"hover": "light-dark(#2650c4, #8aa8f9)",
			"text": "light-dark(#ffffff, #0b0d12)",
			"subtle": "light-dark(#e9effc, #182444)",
			"border": "light-dark(#bdcdf7, #2c3d68)"
		},
		"success": {
			"default": "light-dark(#136b43, #5ecb92)",
			"subtle": "light-dark(#e2f3e9, #102a1e)",
			"indicator": "light-dark(#1f9d5f, #35b877)"
		},
		"warning": {
			"default": "light-dark(#8a5806, #e3b360)",
			"subtle": "light-dark(#faf0d9, #2b2312)",
			"indicator": "light-dark(#cf8d16, #d69f3c)"
		},
		"danger": {
			"default": "light-dark(#a92420, #f28d84)",
			"subtle": "light-dark(#fbeae9, #301917)",
			"indicator": "light-dark(#d6403a, #e0655c)"
		}
	},
	"border": {
		"color": {
			"default": "light-dark(#e2e5ec, #242936)",
			"strong": "light-dark(#ccd2dd, #353c4c)"
		},
		"radius": {
			"small": "6px",
			"medium": "10px",
			"large": "16px"
		}
	},
	"backgroundImage": "none",
	"backgroundSize": "auto",
	"boxShadow": {
		"color": "light-dark(rgb(17 20 27 / 9%), rgb(0 0 0 / 45%))",
		"style": "soft"
	},
	"typography": {
		"fontSize": {
			"base": "13px",
			"small": "12px",
			"xsmall": "11px",
			"xxsmall": "10px",
			"pageTitle": "26px",
			"panelTitle": "15px",
			"entryTitle": "13.5px",
			"editor": "14px",
			"editorTitle": "34px",
			"stat": "30px"
		},
		"fontWeight": {
			"display": 600,
			"entryTitle": 500
		},
		"letterSpacing": {
			"pageTitle": "-.024em",
			"entryTitle": "-.005em"
		}
	},
	"padding": {
		"row": "14px",
		"panel": "17px",
		"inline": "22px"
	}
}
