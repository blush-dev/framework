{
	"$schema": "../../schemas/tokens.schema.json",
	"color": {
		"background": "light-dark(#edeee9, #0e1211)",
		"surface": {
			"default": "light-dark(#fafaf7, #151a18)",
			"subtle": "light-dark(#ecede7, #1c2220)",
			"strong": "light-dark(#e0e2da, #252c29)"
		},
		"text": {
			"default": "light-dark(#171c19, #ecefe9)",
			"secondary": "light-dark(#4f5651, #a9b1ab)",
			"muted": "light-dark(#7c837d, #7c857f)"
		},
		"accent": {
			"default": "light-dark(#1f4d3e, #8fc9ae)",
			"hover": "light-dark(#173d31, #a6d6bf)",
			"text": "light-dark(#fafaf7, #0e1211)",
			"subtle": "light-dark(#cde0d6, #1f3a2e)",
			"border": "light-dark(#a9c7b8, #2f5143)"
		},
		"success": {
			"default": "light-dark(#4d6116, #bfd277)",
			"subtle": "light-dark(#eef2d9, #232913)",
			"indicator": "light-dark(#6c871c, #9cb546)"
		},
		"warning": {
			"default": "light-dark(#7b5310, #e3b468)",
			"subtle": "light-dark(#f6ead2, #2c2314)",
			"indicator": "light-dark(#ac7414, #cd9a45)"
		},
		"danger": {
			"default": "light-dark(#a3302b, #f0918a)",
			"subtle": "light-dark(#f8e4e1, #311a1a)",
			"indicator": "light-dark(#cb4a40, #da675e)"
		}
	},
	"border": {
		"color": {
			"default": "light-dark(#dfe1d9, #232a27)",
			"strong": "light-dark(#bfc3b7, #36403c)"
		},
		"radius": {
			"small": "4px",
			"medium": "6px",
			"large": "10px"
		}
	},
	"boxShadow": {
		"color": "light-dark(rgb(23 28 25 / 11%), rgb(0 0 0 / 50%))",
		"style": "soft"
	},
	"typography": {
		"fontFamily": {
			"ui": [
				"-apple-system",
				"BlinkMacSystemFont",
				"Segoe UI Variable Text",
				"Segoe UI",
				"system-ui",
				"Roboto",
				"Noto Sans",
				"Ubuntu",
				"Cantarell",
				"Helvetica Neue",
				"Arial",
				"sans-serif"
			],
			"display": [
				"Iowan Old Style",
				"Sitka Heading",
				"Charter",
				"Bitstream Charter",
				"Cambria",
				"Noto Serif",
				"DejaVu Serif",
				"Georgia",
				"serif"
			],
			"title": [
				"Iowan Old Style",
				"Charter",
				"Bitstream Charter",
				"Sitka Text",
				"Cambria",
				"Noto Serif",
				"DejaVu Serif",
				"Georgia",
				"serif"
			]
		},
		"fontSize": {
			"base": "13px",
			"pageTitle": "30px",
			"entryTitle": "15px",
			"stat": "32px",
			"small": "12px",
			"xsmall": "11px",
			"xxsmall": "10px",
			"panelTitle": "15px",
			"editor": "14px",
			"editorTitle": "34px"
		},
		"fontWeight": {
			"display": 600,
			"entryTitle": 600
		},
		"letterSpacing": {
			"pageTitle": "-.01em",
			"entryTitle": "0"
		}
	},
	"padding": {
		"row": "14px",
		"panel": "17px",
		"inline": "22px"
	}
}
