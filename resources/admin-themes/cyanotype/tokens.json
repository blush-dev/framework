			"border": "light-dark(#a9c1da, #36597c)"
		},
		"success": {
			"default": "light-dark(#2a6a45, #7fd3a3)",
			"subtle": "light-dark(#e2efe5, #10302b)",
			"indicator": "light-dark(#3a8d5c, #4fb37c)"
		},
		"warning": {
			"default": "light-dark(#7b5310, #e8bb6c)",
			"subtle": "light-dark(#f6ead2, #2e2a1c)",
