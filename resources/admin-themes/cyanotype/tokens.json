				"system-ui",
				"Roboto",
				"Noto Sans",
				"Ubuntu",
				"Cantarell",
				"Helvetica Neue",
				"Arial",
				"sans-serif"
			],
			"display": [
				"-apple-system",
				"BlinkMacSystemFont",
				"Segoe UI Variable Text",
				"Segoe UI",
				"system-ui",
				"Roboto",
				"Noto Sans",
				"Ubuntu",
				"Cantarell",
				"Helvetica Neue",
				"Arial",
				"sans-serif"
			],
			"title": [
				"-apple-system",
