{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["vite/client"],
		"paths": { "blush/messages": ["../site/js/messages.ts"] }
	},
	"include": ["js/**/*.ts", "js/**/*.vue", "../player/**/*.ts", "../site/js/messages.ts"]
}
