{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Blush Framework field set",
	"description": "A field set: fields added to each place it targets, such as content types. It's named after its file.",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"type": "string",
			"description": "The JSON Schema editors check this file with."
		},
		"name": {
			"type": "string",
			"pattern": "^[a-z0-9][a-z0-9_-]*$",
			"description": "The set's name, which must match its file's."
		},
		"label": {
			"type": "string",
			"description": "The set's name for people, heading its fields in the admin. Its name, made readable, by default."
		},
		"description": {
			"type": "string",
			"description": "Help text, shown under the label in the admin."
		},
		"targets": {
			"description": "Where the fields are added, all of one kind (type:, media:, or settings:).",
			"anyOf": [
				{
					"type": "string",
					"pattern": "^[a-z]+:[a-z0-9][a-z0-9_-]*$",
					"description": "A place the set's fields are added: a kind and a name, such as type:post for the post content type."
				},
				{
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^[a-z]+:[a-z0-9][a-z0-9_-]*$",
						"description": "A place the set's fields are added: a kind and a name, such as type:post for the post content type."
					}
				}
			]
		},
		"slot": {
			"type": "string",
			"pattern": "^[a-z0-9][a-z0-9_-]*$",
			"description": "The slot its places show it in, from the ones their kind offers; every kind has details, its default. Left out, the kind's default."
		},
		"fields": {
			"description": "The fields: a list of definitions with names, or a map of names to definitions.",
			"anyOf": [
				{
					"type": "array",
					"items": {
						"allOf": [
							{
								"$ref": "#/definitions/field"
							},
							{
								"required": [
									"name"
								]
							}
						]
					}
				},
				{
					"type": "object",
					"additionalProperties": {
						"$ref": "#/definitions/field"
					}
				}
			]
		},
		"id": {
			"type": "string",
			"description": "The set's id, written when it's saved."
		}
	},
	"definitions": {
		"field": {
			"type": "object",
			"description": "A field definition.",
			"properties": {
				"name": {
					"type": "string",
					"description": "The key the value is read from. Fields in a map are named by their key."
				},
				"type": {
					"description": "The field type. Extensions may add others.",
					"default": "text",
					"anyOf": [
						{
							"const": "text",
							"description": "A line of text."
						},
						{
							"const": "markdown",
							"description": "Formatted text."
						},
						{
							"const": "date",
							"description": "A date and time."
						},
						{
							"const": "bool",
							"description": "true or false."
						},
						{
							"const": "number",
							"description": "A number."
						},
						{
							"const": "enum",
							"description": "One of a set of values."
						},
						{
							"const": "list",
							"description": "Several values."
						},
						{
							"const": "media",
							"description": "A media file."
						},
						{
							"const": "slug",
							"description": "A URL-safe name."
						},
						{
							"const": "object",
							"description": "A group of fields."
						},
						{
							"type": "string"
						}
					]
				},
				"required": {
					"type": "boolean",
					"description": "Whether a value must be present."
				},
				"default": {
					"description": "The value used when none is given."
				},
				"aliases": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"description": "Other keys the value may be read from."
				},
				"label": {
					"type": "string",
					"description": "A human-readable name."
				},
				"description": {
					"type": "string",
					"description": "Help text."
				},
				"control": {
					"description": "How the field is entered. Either `type` or `control` may be left out: a control names its type, and a type has a default control.",
					"anyOf": [
						{
							"const": "group",
							"description": "Group"
						},
						{
							"const": "repeater",
							"description": "Repeating Group"
						},
						{
							"const": "text",
							"description": "Text"
						},
						{
							"const": "textarea",
							"description": "Textarea"
						},
						{
							"const": "markdown",
							"description": "Formatted Text"
						},
						{
							"const": "link",
							"description": "Link"
						},
						{
							"const": "email",
							"description": "Email"
						},
						{
							"const": "select",
							"description": "Select Dropdown"
						},
						{
							"const": "radios",
							"description": "Radio Buttons"
						},
						{
							"const": "checkboxes",
							"description": "Checkboxes"
						},
						{
							"const": "multiselect",
							"description": "Multi-Select"
						},
						{
							"const": "toggle",
							"description": "Toggle"
						},
						{
							"const": "number",
							"description": "Number"
						},
						{
							"const": "date",
							"description": "Date and Time"
						},
						{
							"const": "image",
							"description": "Image"
						},
						{
							"const": "video",
							"description": "Video"
						},
						{
							"const": "audio",
							"description": "Audio"
						},
						{
							"const": "file",
							"description": "File"
						},
						{
							"const": "icon",
							"description": "Icon"
						},
						{
							"const": "code",
							"description": "Code"
						},
						{
							"const": "reference",
							"description": "Entry Picker"
						},
						{
							"const": "readonly",
							"description": "Read-only"
						}
					]
				},
				"itemLabel": {
					"type": "string",
					"description": "What each item is called, for \"Add Ingredient\"."
				},
				"summary": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"description": "The keys of the fields that sum an item up in one line when it's closed."
				},
				"placeholder": {
					"type": "string",
					"description": "A prompt shown in the empty box. Never saved."
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"type": {
								"const": "text"
							}
						},
						"required": [
							"type"
						]
					},
					"then": {
						"properties": {
							"format": {
								"enum": [
									"url",
									"email",
									"icon"
								],
								"description": "What the text must look like: a web address, an email address, or an icon name."
							},
							"control": {
								"enum": [
									"text",
									"textarea",
									"link",
									"email",
									"icon",
									"code",
									"readonly"
								]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "markdown"
							}
						},
						"required": [
							"type"
						]
					},
					"then": {
						"properties": {
							"control": {
								"enum": [
									"markdown",
									"readonly"
								]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "date"
							}
						},
						"required": [
							"type"
						]
					},
					"then": {
						"properties": {
							"time": {
								"type": "boolean",
								"description": "Whether the value has a time; without one, only the day is kept.",
								"default": true
							},
							"control": {
								"enum": [
									"date",
									"readonly"
								]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "bool"
							}
						},
						"required": [
							"type"
						]
					},
					"then": {
						"properties": {
							"default": {
								"type": "boolean"
							},
							"control": {
								"enum": [
									"toggle",
									"readonly"
								]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "number"
							}
						},
						"required": [
							"type"
						]
					},
					"then": {
						"properties": {
							"integer": {
								"type": "boolean",
								"description": "Whether the value must be a whole number."
							},
							"min": {
								"type": "number",
								"description": "The smallest value allowed."
							},
							"max": {
								"type": "number",
								"description": "The largest value allowed."
							},
							"step": {
								"type": "number",
								"exclusiveMinimum": 0,
								"description": "How far apart values are, counted from the minimum (or zero)."
							},
							"default": {
								"type": "number"
							},
							"control": {
								"enum": [
									"number",
									"readonly"
								]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "enum"
							}
						},
						"required": [
							"type"
						]
					},
					"then": {
						"properties": {
							"options": {
								"type": "array",
								"description": "The values allowed, each a value or a value with a label for people.",
								"items": {
									"anyOf": [
										{
											"type": "string"
										},
										{
											"type": "object",
											"properties": {
												"value": {
													"type": "string"
												},
												"label": {
													"type": "string"
												}
											},
											"required": [
												"value"
											]
										}
									]
								},
								"minItems": 1
							},
							"default": {
								"type": "string"
							},
							"control": {
								"enum": [
									"select",
									"radios",
									"readonly"
								]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "list"
							}
						},
						"required": [
							"type"
						]
					},
					"then": {
						"properties": {
							"item": {
								"$ref": "#/definitions/field",
								"description": "A field definition for each value; text by default."
							},
							"min": {
								"type": "integer",
								"minimum": 0,
								"description": "The fewest items a value may have."
							},
							"max": {
								"type": "integer",
								"minimum": 0,
								"description": "The most items a value may have."
							},
							"default": {
								"type": "array"
							},
							"control": {
								"enum": [
									"repeater",
									"checkboxes",
									"multiselect",
									"readonly"
								]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "media"
							}
						},
						"required": [
							"type"
						]
					},
					"then": {
						"properties": {
							"kind": {
								"enum": [
									"image",
									"video",
									"audio",
									"document",
									"file"
								],
								"description": "The kind of file it takes, so the admin's picker offers only those."
							},
							"control": {
								"enum": [
									"image",
									"video",
									"audio",
									"file",
									"code",
									"readonly"
								]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "slug"
							}
						},
						"required": [
							"type"
						]
					},
					"then": {
						"properties": {
							"control": {
								"enum": [
									"code",
									"readonly"
								]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "object"
							}
						},
						"required": [
							"type"
						]
					},
					"then": {
						"properties": {
							"fields": {
								"type": "array",
								"description": "The fields in the group.",
								"items": {
									"allOf": [
										{
											"$ref": "#/definitions/field"
										},
										{
											"required": [
												"name"
											]
										}
									]
								}
							},
							"closed": {
								"type": "boolean",
								"description": "Whether keys the group doesn't declare are errors."
							},
							"default": {
								"type": "object"
							},
							"control": {
								"enum": [
									"group",
									"readonly"
								]
							}
						}
					}
				}
			]
		}
	}
}
