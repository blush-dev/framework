{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Blush Framework field",
	"description": "A field in the site's field library, which content types place by their layout. Its key is its file's name.",
	"allOf": [
		{
			"$ref": "#/definitions/field"
		},
		{
			"properties": {
				"$schema": {
					"type": "string",
					"description": "The JSON Schema editors check this file with."
				},
				"name": {
					"type": "string",
					"pattern": "^[a-z_][a-z0-9_]*$",
					"description": "The field's key, which must match its file's name."
				},
				"id": {
					"type": "string",
					"description": "The field's id, written when it's saved."
				}
			}
		}
	],
	"definitions": {
		"field": {
			"type": "object",
			"description": "A field definition.",
			"properties": {
				"name": {
					"type": "string",
					"description": "The key the value is read from. Fields in a map are named by their key."
				},
				"type": {
					"description": "The field type. Extensions may add others.",
					"default": "text",
					"anyOf": [
						{
							"const": "text",
							"description": "A line of text."
						},
						{
							"const": "markdown",
							"description": "Formatted text."
						},
						{
							"const": "date",
							"description": "A date and time."
						},
						{
							"const": "bool",
							"description": "true or false."
						},
						{
							"const": "number",
							"description": "A number."
						},
						{
							"const": "enum",
							"description": "One of a set of values."
						},
						{
							"const": "list",
							"description": "Several values."
						},
						{
							"const": "media",
							"description": "A media file."
						},
						{
							"const": "slug",
							"description": "A URL-safe name."
						},
						{
							"const": "object",
							"description": "A group of fields."
						},
						{
							"type": "string"
						}
					]
				},
				"required": {
					"type": "boolean",
					"description": "Whether a value must be present."
				},
				"default": {
					"description": "The value used when none is given."
				},
				"aliases": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"description": "Other keys the value may be read from."
				},
				"label": {
					"type": "string",
					"description": "A human-readable name."
				},
				"description": {
					"type": "string",
					"description": "Help text."
				},
				"control": {
					"type": "object",
					"description": "How the field is entered (D-795): the control's `name` and its own options, beside the field. Either `type` or `control` may be left out: a control names its type, and a type has a default control.",
					"required": [
						"name"
					],
					"additionalProperties": false,
					"properties": {
						"name": {
							"anyOf": [
								{
									"const": "object",
									"description": "Object"
								},
								{
									"const": "list",
									"description": "List"
								},
								{
									"const": "text",
									"description": "Text"
								},
								{
									"const": "textarea",
									"description": "Textarea"
								},
								{
									"const": "markdown",
									"description": "Formatted Text"
								},
								{
									"const": "link",
									"description": "Link"
								},
								{
									"const": "email",
									"description": "Email"
								},
								{
									"const": "select",
									"description": "Select Dropdown"
								},
								{
									"const": "radios",
									"description": "Radio Buttons"
								},
								{
									"const": "checkboxes",
									"description": "Checkboxes"
								},
								{
									"const": "multiselect",
									"description": "Multi-Select"
								},
								{
									"const": "toggle",
									"description": "Toggle"
								},
								{
									"const": "number",
									"description": "Number"
								},
								{
									"const": "date",
									"description": "Date and Time"
								},
								{
									"const": "image",
									"description": "Image"
								},
								{
									"const": "video",
									"description": "Video"
								},
								{
									"const": "audio",
									"description": "Audio"
								},
								{
									"const": "file",
									"description": "File"
								},
								{
									"const": "icon",
									"description": "Icon"
								},
								{
									"const": "code",
									"description": "Code"
								},
								{
									"const": "reference",
									"description": "Entry Picker"
								},
								{
									"const": "readonly",
									"description": "Read-only"
								}
							]
						},
						"itemLabel": {
							"type": "string",
							"description": "What each item is called, for \"Add Ingredient\"."
						},
						"summary": {
							"type": "array",
							"items": {
								"type": "string"
							},
							"description": "The keys of the fields that sum an item up in one line when it's closed."
						},
						"placeholder": {
							"type": "string",
							"description": "A prompt shown in the empty box. Never saved."
						}
					}
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"type": {
								"const": "text"
							}
						},
						"required": [
							"type"
						]
					},
					"then": {
						"properties": {
							"format": {
								"enum": [
									"url",
									"email",
									"icon"
								],
								"description": "What the text must look like: a web address, an email address, or an icon name."
							},
							"control": {
								"properties": {
									"name": {
										"enum": [
											"text",
											"textarea",
											"link",
											"email",
											"icon",
											"code",
											"readonly"
										]
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "markdown"
							}
						},
						"required": [
							"type"
						]
					},
					"then": {
						"properties": {
							"control": {
								"properties": {
									"name": {
										"enum": [
											"markdown",
											"readonly"
										]
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "date"
							}
						},
						"required": [
							"type"
						]
					},
					"then": {
						"properties": {
							"time": {
								"type": "boolean",
								"description": "Whether the value has a time; without one, only the day is kept.",
								"default": true
							},
							"control": {
								"properties": {
									"name": {
										"enum": [
											"date",
											"readonly"
										]
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "bool"
							}
						},
						"required": [
							"type"
						]
					},
					"then": {
						"properties": {
							"default": {
								"type": "boolean"
							},
							"control": {
								"properties": {
									"name": {
										"enum": [
											"toggle",
											"readonly"
										]
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "number"
							}
						},
						"required": [
							"type"
						]
					},
					"then": {
						"properties": {
							"integer": {
								"type": "boolean",
								"description": "Whether the value must be a whole number."
							},
							"min": {
								"type": "number",
								"description": "The smallest value allowed."
							},
							"max": {
								"type": "number",
								"description": "The largest value allowed."
							},
							"step": {
								"type": "number",
								"exclusiveMinimum": 0,
								"description": "How far apart values are, counted from the minimum (or zero)."
							},
							"default": {
								"type": "number"
							},
							"control": {
								"properties": {
									"name": {
										"enum": [
											"number",
											"readonly"
										]
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "enum"
							}
						},
						"required": [
							"type"
						]
					},
					"then": {
						"properties": {
							"options": {
								"type": "array",
								"description": "The values allowed, each a value or a value with a label for people.",
								"items": {
									"anyOf": [
										{
											"type": "string"
										},
										{
											"type": "object",
											"properties": {
												"value": {
													"type": "string"
												},
												"label": {
													"type": "string"
												}
											},
											"required": [
												"value"
											]
										}
									]
								},
								"minItems": 1
							},
							"default": {
								"type": "string"
							},
							"control": {
								"properties": {
									"name": {
										"enum": [
											"select",
											"radios",
											"readonly"
										]
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "list"
							}
						},
						"required": [
							"type"
						]
					},
					"then": {
						"properties": {
							"item": {
								"$ref": "#/definitions/field",
								"description": "A field definition for each value; text by default."
							},
							"min": {
								"type": "integer",
								"minimum": 0,
								"description": "The fewest items a value may have."
							},
							"max": {
								"type": "integer",
								"minimum": 0,
								"description": "The most items a value may have."
							},
							"default": {
								"type": "array"
							},
							"control": {
								"properties": {
									"name": {
										"enum": [
											"list",
											"checkboxes",
											"multiselect",
											"readonly"
										]
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "media"
							}
						},
						"required": [
							"type"
						]
					},
					"then": {
						"properties": {
							"kind": {
								"enum": [
									"image",
									"video",
									"audio",
									"document",
									"file"
								],
								"description": "The kind of file it takes, so the admin's picker offers only those."
							},
							"control": {
								"properties": {
									"name": {
										"enum": [
											"image",
											"video",
											"audio",
											"file",
											"code",
											"readonly"
										]
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "slug"
							}
						},
						"required": [
							"type"
						]
					},
					"then": {
						"properties": {
							"control": {
								"properties": {
									"name": {
										"enum": [
											"text",
											"code",
											"readonly"
										]
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "object"
							}
						},
						"required": [
							"type"
						]
					},
					"then": {
						"properties": {
							"fields": {
								"type": "array",
								"description": "The fields in the group.",
								"items": {
									"allOf": [
										{
											"$ref": "#/definitions/field"
										},
										{
											"required": [
												"name"
											]
										}
									]
								}
							},
							"closed": {
								"type": "boolean",
								"description": "Whether keys the group doesn't declare are errors."
							},
							"default": {
								"type": "object"
							},
							"control": {
								"properties": {
									"name": {
										"enum": [
											"object",
											"readonly"
										]
									}
								}
							}
						}
					}
				}
			]
		}
	}
}
